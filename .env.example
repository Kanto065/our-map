# Copy this file to ".env" and fill in your own values.
# All keys are client-side (Vite exposes VITE_* to the browser) — use the
# public anon / client keys only, never service-role secrets.

# ---- Supabase Storage (photo hosting) ----
# Create a free project at https://supabase.com, then:
#   1. Storage → New bucket → name it "memories" → make it PUBLIC
#   2. Settings → API → copy the Project URL and the anon/public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_BUCKET=memories

# ---- Jamendo (Creative Commons music for the song picker) ----
# Register a free app at https://devportal.jamendo.com to get a Client ID.
VITE_JAMENDO_CLIENT_ID=your-jamendo-client-id
